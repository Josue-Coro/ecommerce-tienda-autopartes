@{
    ViewBag.Title = "Homologación SIN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Resumen</a></li>
    <li class="breadcrumb-item">Facturación</li>
    <li class="breadcrumb-item active">Homologación</li>
</ol>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <ul class="nav nav-tabs card-header-tabs" role="tablist" id="tabsHomologacion">
            <li class="nav-item"><button class="nav-link active" data-tipo="PRODUCTO" data-catalogo="PRODUCTO_SERVICIO" type="button"><i class="fas fa-box me-1"></i>Productos</button></li>
            <li class="nav-item"><button class="nav-link" data-tipo="SERVICIO" data-catalogo="PRODUCTO_SERVICIO" type="button"><i class="fas fa-tools me-1"></i>Servicios</button></li>
            <li class="nav-item"><button class="nav-link" data-tipo="UNIDAD_MEDIDA" data-catalogo="UNIDAD_MEDIDA" type="button"><i class="fas fa-ruler me-1"></i>Unidades de medida</button></li>
            <li class="nav-item"><button class="nav-link" data-tipo="TIPO_PAGO" data-catalogo="METODO_PAGO" type="button"><i class="fas fa-coins me-1"></i>Tipos de pago</button></li>
        </ul>
    </div>
    <div class="card-body">
        <p class="small text-muted" id="txtAyuda"></p>
        <div class="mb-2"><span class="badge bg-success" id="badgeHomologados"></span> <span class="badge bg-warning text-dark" id="badgePendientes"></span></div>
        <table id="tablaHomologacion" class="display cell-border" style="width:100%">
            <thead>
                <tr>
                    <th>Registro propio</th>
                    <th>Código del SIN</th>
                    <th style="width:110px"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section scripts {
    <script>
        var tipoActual = "PRODUCTO";
        var catalogoActual = "PRODUCTO_SERVICIO";
        var cacheCatalogos = {};
        var tablaHomologacion;

        var ayudas = {
            PRODUCTO: "Relacione cada producto con el código genérico del SIN. Ese código va en el XML de la factura; en la impresión se muestra su código interno.",
            SERVICIO: "Relacione cada servicio con el código genérico del SIN. Los servicios se facturan con la unidad de medida 58 (unidad - servicios).",
            UNIDAD_MEDIDA: "Relacione sus unidades de medida con las del SIN. Los productos cuya unidad no esté homologada se facturan como 57 (unidad - bienes).",
            TIPO_PAGO: "Relacione sus tipos de pago con los métodos de pago del SIN. Es obligatorio para poder facturar."
        };

        function escapar(texto) { return $("<span>").text(texto == null ? "" : texto).html(); }

        function obtenerCatalogo(tipo) {
            if (cacheCatalogos[tipo]) return $.Deferred().resolve(cacheCatalogos[tipo]).promise();
            return $.get('@Url.Action("ListarCatalogo", "Facturacion")', { tipo: tipo }).then(function (res) {
                cacheCatalogos[tipo] = res.data;
                return res.data;
            });
        }

        function opcionesCatalogo(lista, seleccionado) {
            var html = '<option value="">-- Sin homologar --</option>';
            $.each(lista, function (i, c) {
                var texto = c.codigo + " - " + c.descripcion + (c.codigo_actividad ? " [" + c.codigo_actividad + "]" : "");
                html += '<option value="' + escapar(c.codigo) + '"' + (c.codigo === seleccionado ? " selected" : "") + ">" + escapar(texto) + "</option>";
            });
            return html;
        }

        function cargar() {
            $("#txtAyuda").text(ayudas[tipoActual]);
            obtenerCatalogo(catalogoActual).then(function (catalogo) {
                if (catalogo.length === 0) {
                    Swal.fire("Catálogos sin sincronizar", "Primero sincronice los catálogos en Facturación > Configuración.", "info");
                }
                $.get('@Url.Action("ListarHomologacion", "Facturacion")', { tipo: tipoActual }, function (res) {
                    var homologados = res.data.filter(function (r) { return r.codigo_sin; }).length;
                    $("#badgeHomologados").text(homologados + " homologados");
                    $("#badgePendientes").text((res.data.length - homologados) + " pendientes");

                    tablaHomologacion.clear();
                    tablaHomologacion.rows.add($.map(res.data, function (r) { r._catalogo = catalogo; return r; }));
                    tablaHomologacion.draw();
                });
            });
        }

        $(function () {
            tablaHomologacion = $("#tablaHomologacion").DataTable({
                responsive: true,
                ordering: false,
                data: [],
                columns: [
                    { data: "descripcion", render: function (v, t, r) { return escapar(v) + (r.codigo_sin ? "" : ' <span class="badge bg-warning text-dark">pendiente</span>'); } },
                    { data: "codigo_sin", render: function (v, t, r) { return '<select class="form-select form-select-sm cbo-codigo">' + opcionesCatalogo(r._catalogo, v) + "</select>"; } },
                    { data: null, defaultContent: '<button type="button" class="btn btn-primary btn-sm btn-guardar"><i class="fas fa-save me-1"></i>Guardar</button>' }
                ]
            });
            cargar();
        });

        $("#tabsHomologacion").on("click", "button", function () {
            $("#tabsHomologacion .nav-link").removeClass("active");
            $(this).addClass("active");
            tipoActual = $(this).data("tipo");
            catalogoActual = $(this).data("catalogo");
            cargar();
        });

        $("#tablaHomologacion tbody").on("click", ".btn-guardar", function () {
            var $tr = $(this).closest("tr");
            if ($tr.hasClass("child")) $tr = $tr.prev();
            var fila = tablaHomologacion.row($tr).data();
            var codigo = $tr.find(".cbo-codigo").val() || $(this).closest("tr").find(".cbo-codigo").val();

            $.ajax({
                url: '@Url.Action("GuardarHomologacion", "Facturacion")',
                type: "POST",
                data: JSON.stringify({ tipo: tipoActual, idRegistro: fila.id_registro, codigoSin: codigo }),
                contentType: "application/json; charset=utf-8"
            }).done(function (res) {
                if (res.resultado) {
                    Swal.fire({ toast: true, position: "top-end", icon: "success", title: res.mensaje, showConfirmButton: false, timer: 1800 });
                    cargar();
                } else {
                    Swal.fire("Atención", res.mensaje, "warning");
                }
            }).fail(function (xhr) {
                Swal.fire("Error", (xhr.responseJSON && xhr.responseJSON.mensaje) || "Error de comunicación con el servidor.", "error");
            });
        });
    </script>
}
