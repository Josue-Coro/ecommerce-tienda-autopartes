@{
    ViewBag.Title = "Contingencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<ol class="breadcrumb mb-4 mt-4">
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Resumen</a></li>
    <li class="breadcrumb-item">Facturación</li>
    <li class="breadcrumb-item active">Contingencia</li>
</ol>

<div class="card shadow-sm mb-4 border-warning" id="tarjetaSimulacion" style="display:none">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <i class="fas fa-flask fa-2x text-warning"></i>
        <div class="flex-grow-1">
            <b>Simulación de corte (solo modo simulado).</b>
            <div class="small text-muted">Al activarla, el SIN simulado deja de responder: la siguiente factura pasa sola a emitirse fuera de línea.
                Al desactivarla, finalice la contingencia para enviar los paquetes.</div>
        </div>
        <div class="form-check form-switch fs-5 mb-0">
            <input class="form-check-input" type="checkbox" id="chkSinConexion">
            <label class="form-check-label fs-6" for="chkSinConexion">SIN sin conexión</label>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white"><i class="fas fa-store me-2"></i><b>Estado por tienda</b></div>
    <div class="card-body">
        <p class="small text-muted">
            Si el SIN no responde, el sistema pasa solo a emitir <b>fuera de línea</b> (evento 2). También puede iniciar la contingencia a mano
            (eventos 1 a 4). Al volver la conexión: <b>Finalizar y enviar</b> obtiene un CUFD nuevo, registra el evento significativo y envía las
            facturas en paquetes de hasta 500. Hay <b>48 horas</b> desde el fin del evento para hacerlo.
        </p>
        <div class="row g-3" id="contenedorTiendas"></div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white"><i class="fas fa-history me-2"></i><b>Eventos significativos</b></div>
    <div class="card-body">
        <table id="tablaEventos" class="display cell-border" style="width:100%">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tienda</th>
                    <th>Evento</th>
                    <th>Periodo</th>
                    <th>Facturas</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal iniciar contingencia -->
<div class="modal fade" id="modalIniciar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-plug me-2"></i>Iniciar contingencia - <span id="inNombreTienda"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="inIdTienda" value="0" />
                <label class="form-label" for="inEvento">Evento significativo</label>
                <select class="form-select mb-3" id="inEvento"></select>
                <label class="form-label" for="inDescripcion">Descripción</label>
                <textarea class="form-control" id="inDescripcion" rows="3" maxlength="500" placeholder="Ej.: Corte de internet del proveedor desde las 10:15"></textarea>
                <div class="form-text">Los eventos 5, 6 y 7 requieren facturas manuales de contingencia (CAFC); aún no están disponibles.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" id="btnConfirmarInicio">Iniciar fuera de línea</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var tablaEventos;
        var coloresEvento = { ABIERTO: "bg-warning text-dark", REGISTRADO: "bg-info text-dark", VALIDADO: "bg-success", OBSERVADO: "bg-danger" };

        function escapar(texto) { return $("<span>").text(texto == null ? "" : texto).html(); }

        function postJson(accion, datos) {
            return $.ajax({
                url: '@Url.Action("__A__", "Facturacion")'.replace("__A__", accion),
                type: "POST",
                data: JSON.stringify(datos || {}),
                contentType: "application/json; charset=utf-8"
            }).fail(function (xhr) {
                Swal.fire("Error", (xhr.responseJSON && xhr.responseJSON.mensaje) || "Error de comunicación con el servidor.", "error");
            });
        }

        function cargarEstado() {
            $.get('@Url.Action("EstadoContingencia", "Facturacion")', function (res) {
                $("#tarjetaSimulacion").toggle(res.modo_simulado);
                $("#chkSinConexion").prop("checked", res.simular_sin_conexion);

                var $c = $("#contenedorTiendas").empty();
                if (res.tiendas.length === 0) {
                    $c.append('<div class="col-12 text-muted">No hay tiendas configuradas para facturar. Configúrelas en Facturación &gt; Configuración.</div>');
                }
                $.each(res.tiendas, function (i, t) {
                    var cuerpo;
                    if (t.fuera_de_linea) {
                        cuerpo = '<span class="badge bg-warning text-dark mb-2"><i class="fas fa-plug"></i> FUERA DE LÍNEA</span>'
                            + '<div class="small">Contingencia #' + t.evento.id_evento + (t.evento.automatico ? " (automática)" : "") + '<br>'
                            + escapar(t.evento.descripcion_evento) + '<br>Desde ' + t.evento.desde + ' &middot; ' + t.evento.cantidad_facturas + ' factura(s)</div>'
                            + '<button type="button" class="btn btn-success btn-sm mt-2 btn-finalizar" data-evento="' + t.evento.id_evento + '">'
                            + '<i class="fas fa-paper-plane me-1"></i>Finalizar y enviar</button>';
                    } else {
                        cuerpo = '<span class="badge bg-success mb-2"><i class="fas fa-wifi"></i> EN LÍNEA</span>'
                            + '<div><button type="button" class="btn btn-outline-warning btn-sm btn-iniciar" data-tienda="' + t.id_tienda + '" data-nombre="'
                            + escapar(t.nombre_tienda) + '"><i class="fas fa-plug me-1"></i>Iniciar contingencia</button></div>';
                    }
                    $c.append('<div class="col-md-6 col-xl-4"><div class="border rounded p-3 h-100 ' + (t.fuera_de_linea ? "border-warning" : "") + '">'
                        + '<div class="fw-bold">' + escapar(t.nombre_tienda) + '</div>'
                        + '<div class="small text-muted mb-2">Sucursal ' + t.codigo_sucursal + ' &middot; Punto de venta ' + t.codigo_punto_venta + '</div>'
                        + cuerpo + '</div></div>');
                });
            });
        }

        function recargar() {
            cargarEstado();
            tablaEventos.ajax.reload();
        }

        $(function () {
            $.get('@Url.Action("ListarCatalogo", "Facturacion")', { tipo: "EVENTO_SIGNIFICATIVO" }, function (res) {
                $.each(res.data, function (i, c) {
                    var $o = $("<option>").val(c.codigo).text(c.codigo + " - " + c.descripcion);
                    if (parseInt(c.codigo) > 4) $o.prop("disabled", true);
                    $("#inEvento").append($o);
                });
            });

            tablaEventos = $("#tablaEventos").DataTable({
                responsive: true,
                ordering: false,
                ajax: { url: '@Url.Action("ListarEventos", "Facturacion")', type: "GET" },
                columns: [
                    { data: "id_evento" },
                    { data: "nombre_tienda", render: escapar },
                    {
                        data: "descripcion_evento", render: function (v, t, r) {
                            return r.codigo_evento + " - " + escapar(v) + (r.automatico ? ' <span class="badge bg-secondary">automático</span>' : "")
                                + '<div class="small text-muted">' + escapar(r.descripcion) + "</div>";
                        }
                    },
                    {
                        data: "fecha_inicio", render: function (v, t, r) {
                            return v + "<br>" + (r.fecha_fin ? "a " + r.fecha_fin : '<i class="text-muted">en curso</i>')
                                + (r.limite_envio && r.estado !== "VALIDADO" ? '<div class="small text-danger">enviar antes de ' + r.limite_envio + "</div>" : "");
                        }
                    },
                    { data: "cantidad_facturas", render: function (v, t, r) { return v + (r.facturas_pendientes > 0 ? '<div class="small text-warning">' + r.facturas_pendientes + " pendiente(s)</div>" : ""); } },
                    {
                        data: "estado", render: function (v, t, r) {
                            return '<span class="badge ' + (coloresEvento[v] || "bg-secondary") + '">' + v + "</span>"
                                + (r.codigo_recepcion_evento ? '<div class="small text-muted">SIN: ' + escapar(r.codigo_recepcion_evento) + "</div>" : "")
                                + (r.mensajes ? '<div class="small">' + escapar(r.mensajes) + "</div>" : "");
                        }
                    },
                    {
                        data: null, orderable: false, width: "130px",
                        render: function (d, t, r) {
                            return r.estado !== "VALIDADO" && (r.estado === "ABIERTO" || r.facturas_pendientes > 0)
                                ? '<button type="button" class="btn btn-success btn-sm btn-finalizar" data-evento="' + r.id_evento + '">'
                                  + (r.estado === "ABIERTO" ? "Finalizar y enviar" : "Reenviar") + "</button>"
                                : "";
                        }
                    }
                ]
            });

            cargarEstado();
        });

        $("#chkSinConexion").on("change", function () {
            var valor = $(this).is(":checked");
            postJson("SimularSinConexion", { valor: valor }).done(function (res) {
                Swal.fire(res.resultado ? (valor ? "Corte simulado" : "Conexión restablecida") : "Atención", res.mensaje, res.resultado ? "info" : "warning");
                cargarEstado();
            });
        });

        $(document).on("click", ".btn-iniciar", function () {
            $("#inIdTienda").val($(this).data("tienda"));
            $("#inNombreTienda").text($(this).data("nombre"));
            $("#inDescripcion").val("");
            $("#modalIniciar").modal("show");
        });

        $("#btnConfirmarInicio").on("click", function () {
            postJson("IniciarContingencia", {
                idTienda: parseInt($("#inIdTienda").val()),
                codigoEvento: parseInt($("#inEvento").val()),
                descripcion: $.trim($("#inDescripcion").val())
            }).done(function (res) {
                if (res.resultado) $("#modalIniciar").modal("hide");
                Swal.fire(res.resultado ? "Contingencia iniciada" : "Atención", res.mensaje, res.resultado ? "success" : "warning");
                recargar();
            });
        });

        $(document).on("click", ".btn-finalizar", function () {
            var idEvento = $(this).data("evento");
            var $btn = $(this).prop("disabled", true);
            postJson("FinalizarContingencia", { idEvento: idEvento }).done(function (res) {
                Swal.fire(res.resultado ? "Contingencia finalizada" : "Atención", res.mensaje, res.resultado ? "success" : "warning");
                recargar();
            }).always(function () { $btn.prop("disabled", false); });
        });
    </script>
}
