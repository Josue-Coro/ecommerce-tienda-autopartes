<?xml version="1.0" encoding="utf-8"?>
<!-- Copie este archivo como Secretos.config (que no se sube al repositorio) y complete sus datos.
     Para Gmail use una "contraseña de aplicación", nunca la contraseña de la cuenta. -->
<appSettings>
  <add key="CorreoRemitente" value="cuenta@gmail.com" />
  <add key="CorreoClave" value="CONTRASEÑA_DE_APLICACION" />
  <add key="CorreoServidor" value="smtp.gmail.com" />
  <add key="CorreoPuerto" value="587" />
</appSettings>
